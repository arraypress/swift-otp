# Test vectors (RFC 4226/6238, the Google Authenticator wiki) — every secret in
# the tests is a published example by design.
Tests/**
# JBSWY3DPEHPK3PXP is the standard example TOTP secret (base32 "Hello!"), and
# secret=… is a written-out placeholder, in the README and error messages.
regex:^JBSWY3DPEHPK3PXP
regex:^…
